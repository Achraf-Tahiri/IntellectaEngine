# =============================================================================
# IntellectaEngine — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your credentials.
# Never commit your actual `.env` file to version control.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your real keys
# =============================================================================

# --- LLM Provider Selection ---------------------------------------------------
# Set the default LLM provider. One of: gemini | groq | openai | ollama
DEFAULT_LLM_PROVIDER=gemini

# --- Google Gemini ------------------------------------------------------------
GOOGLE_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-3.5-flash

# --- Groq (LLaMA, Mixtral, etc.) ----------------------------------------------
GROQ_API_KEY=
DEFAULT_GROQ_MODEL=llama-3.1-8b-instant

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# --- Ollama (local deployment) ------------------------------------------------
# Make sure Ollama is running locally: `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.2

# --- Embedding Configuration --------------------------------------------------
# Provider for embeddings. One of: gemini | huggingface | openai | fastembed
DEFAULT_EMBEDDING_PROVIDER=huggingface
# HuggingFace embedding model (used when provider=huggingface)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2

# --- ChromaDB Vector Store ---------------------------------------------------
# Base directory for persisting Chroma collections on disk
CHROMA_PERSIST_BASE_DIR=./data/chroma

# --- RAG Retrieval Settings ---------------------------------------------------
# Number of document chunks to retrieve per query
RAG_TOP_K=5
# Chunk size in characters
RAG_CHUNK_SIZE=1000
# Overlap between consecutive chunks
RAG_CHUNK_OVERLAP=200
# Safety limits. These are in-process limits, not a sandbox for a hostile PDF parser.
RAG_MAX_UPLOAD_BYTES=20000000
RAG_MAX_FILES=10
RAG_MAX_PAGES=500
RAG_MAX_CHUNKS=5000
# Context characters include source labels and separators; exclude instructions/question.
RAG_CONTEXT_CHAR_LIMIT=12000

# --- Web Research Tool --------------------------------------------------------
# Maximum number of search results to fetch
WEB_SEARCH_MAX_RESULTS=5
# Jina read timeout; connect timeout is min(5, value). Also passed to DDGS.
WEB_SCRAPE_TIMEOUT=15
WEB_QUERY_CHAR_LIMIT=1000
WEB_URL_CHAR_LIMIT=2048
# Entire tool observation, including headings, sources and truncation markers
WEB_OBSERVATION_CHAR_LIMIT=6000
# Identity-encoded response bytes; one extra byte detects overflow
WEB_RESPONSE_BYTE_LIMIT=262144
# Checked between Jina reads; not hard wall-clock cancellation
WEB_ELAPSED_SECONDS=30

# --- SQL Agent ----------------------------------------------------------------
# Enforced rows per SQL statement (1..1000), at most one extra overflow row read
SQL_TOP_K=10
# JSON list of absolute approved directories; [] disables custom files.
# Example: SQL_ALLOWED_ROOTS=["/home/me/approved-databases"]
SQL_ALLOWED_ROOTS=[]
# Characters per displayed cell and entire tool observation, including truncation markers
SQL_CELL_CHAR_LIMIT=1000
SQL_OBSERVATION_CHAR_LIMIT=12000
# SQLite VM deadline and work budget (checked every 1000 instructions)
SQL_STATEMENT_SECONDS=2.0
SQL_STATEMENT_STEPS=1000000
# SQLite busy/lock wait; separate from the VM progress deadline
SQL_LOCK_TIMEOUT_MS=250

# --- Application --------------------------------------------------------------
APP_TITLE=IntellectaEngine
APP_SUBTITLE=Unified AI Knowledge & Research Platform
LOG_LEVEL=INFO
